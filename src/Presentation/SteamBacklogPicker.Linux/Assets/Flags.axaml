<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Vector flags on a 28x20 canvas, shared geometry with the WPF
        Themes/Flags.xaml. Brazil follows the official 20x14 construction
        grid scaled by 1.4; the US canton spans 7 of the 13 stripes with the
        50 stars in staggered 6/5 rows.
    -->

    <DrawingImage x:Key="FlagBrazilImage">
        <DrawingGroup>
            <GeometryDrawing Brush="#009C3B"
                             Geometry="M0,0 L28,0 L28,20 L0,20 Z" />
            <GeometryDrawing Brush="#FFDF00"
                             Geometry="M14,2.43 L25.62,10 L14,17.57 L2.38,10 Z" />
            <GeometryDrawing Brush="#002776"
                             Geometry="M14,10 m-4.9,0 a4.9,4.95 0 1,0 9.8,0 a4.9,4.95 0 1,0 -9.8,0" />
            <GeometryDrawing Geometry="M9.47,10.8 A9.5,9.5 0 0 1 18.32,8.43">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFF" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingGroup>
    </DrawingImage>

