<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:SteamBacklogPicker.Linux.Converters"
        x:Class="SteamBacklogPicker.Linux.Views.MainWindow"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Title="Steam Backlog Picker"
        mc:Ignorable="d">
  <Grid RowDefinitions="Auto,*">

    <!-- ============ Header bar ============ -->
    <Border Grid.Row="0" Classes="headerBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
          <Border Width="42"
                  Height="42"
                  CornerRadius="11"
                  Background="{DynamicResource AccentGradientBrush}">
            <!-- Die face (three pips) -->
            <Grid>
              <Ellipse Width="6.5" Height="6.5" Fill="White"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="10,10,0,0" />
              <Ellipse Width="6.5" Height="6.5" Fill="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse Width="6.5" Height="6.5" Fill="White"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,10,10" />
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="appTitle" Text="Steam Backlog Picker" />
            <TextBlock Classes="appSubtitle" Text="{DynamicResource Header_Tagline}" />
          </StackPanel>
        </StackPanel>

        <!-- Language selector -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10">
          <Button Classes="lang"
                  Classes.activeLanguage="{Binding CurrentLanguage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=pt-BR}"
                  Command="{Binding ChangeLanguageCommand}"
                  CommandParameter="pt-BR"
                  ToolTip.Tip="{DynamicResource Language_Portuguese}">
            <Image Source="{DynamicResource FlagBrazilImage}" Width="28" Height="20" />
          </Button>
          <Button Classes="lang"
                  Classes.activeLanguage="{Binding CurrentLanguage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=en-US}"
                  Command="{Binding ChangeLanguageCommand}"
                  CommandParameter="en-US"
                  ToolTip.Tip="{DynamicResource Language_English}">
            <Image Source="{DynamicResource FlagUnitedStatesImage}" Width="28" Height="20" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Content ============ -->
    <Grid Grid.Row="1" Margin="20,16,20,20" ColumnDefinitions="320,26,*">

      <!-- Sidebar: filters and actions -->
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="sectionTitle"
                     Margin="0,0,0,16"
                     Text="{DynamicResource Filters_Title}" />

          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
              <CheckBox Content="{DynamicResource Filters_RequireInstalled}"
                        IsChecked="{Binding Preferences.RequireInstalled, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_ExcludeDeckUnsupported}"
                        IsChecked="{Binding Preferences.ExcludeDeckUnsupported, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_RequireMacCompatible}"
                        IsChecked="{Binding Preferences.RequireMacCompatible, Mode=TwoWay}" />

              <TextBlock Classes="sectionLabel" Text="{DynamicResource Filters_ContentTypesLabel}" />
              <CheckBox Content="{DynamicResource Filters_IncludeGames}"
                        IsChecked="{Binding Preferences.IncludeGames, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_IncludeSoundtracks}"
                        IsChecked="{Binding Preferences.IncludeSoundtracks, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_IncludeSoftware}"
                        IsChecked="{Binding Preferences.IncludeSoftware, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_IncludeTools}"
                        IsChecked="{Binding Preferences.IncludeTools, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_IncludeVideos}"
                        IsChecked="{Binding Preferences.IncludeVideos, Mode=TwoWay}" />
              <CheckBox Content="{DynamicResource Filters_IncludeOther}"
                        IsChecked="{Binding Preferences.IncludeOther, Mode=TwoWay}" />

              <TextBlock Classes="sectionLabel" Text="{DynamicResource Filters_StorefrontsLabel}" />
              <CheckBox Content="{DynamicResource Filters_IncludeSteam}"
                        IsChecked="{Binding Preferences.IncludeSteam, Mode=TwoWay}" />

              <TextBlock Classes="sectionLabel" Text="{DynamicResource Filters_CollectionLabel}" />
              <ComboBox ItemsSource="{Binding Preferences.CollectionOptions}"
                        SelectedItem="{Binding Preferences.SelectedCollection, Mode=TwoWay}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Actions + status -->
          <StackPanel Grid.Row="2" Spacing="10">
            <Border Height="1"
                    Background="{DynamicResource SurfaceBorderBrush}"
                    Margin="0,14,0,4" />

            <Button Classes="secondary"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    Command="{Binding RefreshCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconRefreshGeometry}"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                  </Canvas>
                </Viewbox>
                <TextBlock VerticalAlignment="Center"
                           Text="{DynamicResource Filters_RefreshButton}" />
              </StackPanel>
            </Button>
            <Button Classes="primary"
                    HorizontalAlignment="Stretch"
                    Height="52"
                    Command="{Binding DrawCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Viewbox Width="17" Height="17">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconShuffleGeometry}"
                          Fill="White" />
                  </Canvas>
                </Viewbox>
                <TextBlock VerticalAlignment="Center"
                           Text="{DynamicResource Filters_DrawButton}" />
              </StackPanel>
            </Button>

            <Border Classes="statusBox" Margin="0,4,0,0">
              <Grid ColumnDefinitions="Auto,*">
                <Ellipse Width="8"
                         Height="8"
                         Fill="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Top"
                         Margin="0,5,10,0" />
                <TextBlock Grid.Column="1"
                           Classes="body"
                           Text="{Binding StatusMessage}" />
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Showcase: drawn game -->
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Featured game header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Classes="sectionLabel"
                         Margin="0"
                         Text="{DynamicResource GameDetails_NextGameTitle}" />
              <TextBlock Classes="gameTitle" Text="{Binding SelectedGame.Title}" />
            </StackPanel>

            <!-- Storefront badge -->
            <Border Grid.Column="1"
                    Classes="tagChip"
                    Margin="16,4,0,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding SelectedGame.HasStorefront}">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconSteamGeometry}"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                  </Canvas>
                </Viewbox>
                <TextBlock FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SelectedGame.StorefrontDisplayName}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Cover -->
          <Border Grid.Row="1"
                  Margin="0,18,0,0"
                  Height="410"
                  CornerRadius="18"
                  Background="{DynamicResource AppBackgroundDeepBrush}"
                  BorderBrush="{DynamicResource SurfaceBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Grid>
              <Image Margin="2"
                     Stretch="Uniform"
                     Source="{Binding SelectedGame.CoverImagePath}"
                     IsVisible="{Binding SelectedGame.HasCoverImage}" />

              <!-- Empty / no-cover placeholder -->
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="10"
                          IsVisible="{Binding SelectedGame.ShowArtworkPlaceholder}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding SelectedGame.ArtworkPlaceholderTitle}" />
                <TextBlock HorizontalAlignment="Center"
                           MaxWidth="360"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding SelectedGame.ArtworkPlaceholderSubtitle}" />
              </StackPanel>

              <!-- Drawing overlay -->
              <Border Background="#E0070A0E"
                      IsVisible="{Binding IsDrawing}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                  <ProgressBar IsIndeterminate="True"
                               Width="180"
                               Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock HorizontalAlignment="Center"
                             FontSize="15"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="{DynamicResource Status_Drawing}" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Footer: status, tags, actions -->
          <Grid Grid.Row="2" Margin="0,18,0,0" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="{Binding SelectedGame.InstallationStatus}" />
              <ItemsControl ItemsSource="{Binding SelectedGame.Tags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="tagChip">
                      <TextBlock FontSize="12"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="16,0,0,0"
                        Spacing="10">
              <Button Classes="secondary"
                      MinHeight="46"
                      MinWidth="124"
                      Content="{DynamicResource GameDetails_InstallButton}"
                      Command="{Binding InstallCommand}"
                      IsEnabled="{Binding SelectedGame.CanInstall}" />
              <Button Classes="primary"
                      MinHeight="46"
                      MinWidth="134"
                      Command="{Binding LaunchCommand}"
                      IsEnabled="{Binding SelectedGame.CanLaunch}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource IconPlayGeometry}"
                            Fill="White" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock VerticalAlignment="Center"
                             Text="{DynamicResource GameDetails_PlayButton}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
