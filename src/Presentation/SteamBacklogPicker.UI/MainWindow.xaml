<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:SteamBacklogPicker.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SteamBacklogPicker.UI.MainWindow" Title="Steam Backlog Picker" Width="1360" Height="960" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#10141D" Foreground="#F2F6FB" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Foreground" Value="#D9E2EF" />
            <Setter Property="Background" Value="#1D2735" />
            <Setter Property="BorderBrush" Value="#344052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="local:VisualMotion.Feedback" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="FeedbackRoot">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <Border x:Name="HoverLayer" Background="White" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="FocusRing" BorderBrush="#A9CBFF" BorderThickness="2" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FeedbackRoot" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#D9E2EF" />
            <Setter Property="Background" Value="#1D2735" />
            <Setter Property="BorderBrush" Value="#344052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="local:VisualMotion.Feedback" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="FeedbackRoot">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <Border x:Name="HoverLayer" Background="White" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="FocusRing" BorderBrush="#A9CBFF" BorderThickness="2" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FeedbackRoot" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#223B5C" />
                                <Setter Property="BorderBrush" Value="#648AC0" />
                                <Setter Property="Foreground" Value="#DFECFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#9DAEC4" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#131B26" />
            <Setter Property="Foreground" Value="#F2F6FB" />
            <Setter Property="BorderBrush" Value="#344052" />
            <Setter Property="Padding" Value="38,9,12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldRoot" Property="BorderBrush" Value="#83B1F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1A2432" />
            <Setter Property="Foreground" Value="#DCE7F7" />
            <Setter Property="BorderBrush" Value="#3E506A" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="#DCE7F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuRow" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuRow" Property="Background" Value="#2A4466" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuRow" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Text" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9B6C9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock" BasedOn="{StaticResource Text}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9FBAE4" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#181F2B" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#283244" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource FilterCheckBoxStyle}">
            <Setter Property="Foreground" Value="#CDD8E9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,8,20,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource SurfaceComboBoxStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8,36,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#0C1017" BorderBrush="#242D3C" BorderThickness="0,0,1,0">
            <Grid Margin="12,30,12,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,0,0,32">
                    <TextBlock Text="STEAM" FontSize="11" Foreground="#8AABDA" FontWeight="Bold" />
                    <TextBlock Text="Backlog Picker" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="discover" AutomationProperties.Name="{DynamicResource Workspace_discover}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiscoverPage}" Value="True">
                                        <Setter Property="Background" Value="#203353" />
                                        <Setter Property="Foreground" Value="#BBD6FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource Workspace_discover}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="library" AutomationProperties.Name="{DynamicResource Workspace_library}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                        <Setter Property="Background" Value="#203353" />
                                        <Setter Property="Foreground" Value="#BBD6FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource Workspace_library}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="history" AutomationProperties.Name="{DynamicResource Workspace_history}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistoryPage}" Value="True">
                                        <Setter Property="Background" Value="#203353" />
                                        <Setter Property="Foreground" Value="#BBD6FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource Workspace_history}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="{DynamicResource Workspace_settings}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="#203353" />
                                        <Setter Property="Foreground" Value="#BBD6FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource Workspace_settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,28,30,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Text}" Margin="0,7,14,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource Button}" AutomationProperties.Name="{DynamicResource Filters_RefreshButton_Automation}" MinWidth="120" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                            <TextBlock Text="{DynamicResource Workspace_Sync}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding LastSyncSummary}" Style="{StaticResource Text}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,22">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHistoryPage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,12,0">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Workspace_Search}" />
                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="#8C9FB9" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{DynamicResource Workspace_Search}" Margin="39,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ToggleButton Grid.Column="1" Content="{DynamicResource Workspace_Installed}" IsChecked="{Binding Preferences.RequireInstalled}" Style="{StaticResource Toggle}" Height="40" MinWidth="110" Margin="0,0,12,0" />
                    <ToggleButton x:Name="FiltersButton" Grid.Column="2" IsChecked="{Binding AdvancedFilters}" Style="{StaticResource Toggle}" Height="40" MinWidth="130" AutomationProperties.Name="{DynamicResource Workspace_Advanced}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                            <TextBlock Text="{DynamicResource Workspace_Advanced}" VerticalAlignment="Center" />
                            <Border Background="#426796" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" Visibility="{Binding HasAdvancedFilterCount, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding AdvancedFilterCount}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Background="#151E2A" BorderBrush="#29374A" BorderThickness="1" CornerRadius="10" Padding="3">
                        <UniformGrid Rows="1" Columns="3" Width="300">
                            <Button Content="{DynamicResource Workspace_All}" Command="{Binding SetOwnershipFilterCommand}" CommandParameter="all">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OwnershipFilter}" Value="all">
                                                <Setter Property="Background" Value="#2A3C56" />
                                                <Setter Property="Foreground" Value="#F2F6FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Workspace_Owned}" Command="{Binding SetOwnershipFilterCommand}" CommandParameter="owned">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OwnershipFilter}" Value="owned">
                                                <Setter Property="Background" Value="#2A3C56" />
                                                <Setter Property="Foreground" Value="#F2F6FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Workspace_Family}" Command="{Binding SetOwnershipFilterCommand}" CommandParameter="family">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OwnershipFilter}" Value="family">
                                                <Setter Property="Background" Value="#2A3C56" />
                                                <Setter Property="Foreground" Value="#F2F6FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>
                    <ComboBox SelectedValue="{Binding BacklogFilter}" SelectedValuePath="Tag" MinWidth="174" Margin="12,0,0,0" AutomationProperties.Name="{DynamicResource Workspace_Backlog}" Height="40">
                        <ComboBoxItem Content="{DynamicResource Workspace_Active}" Tag="active" />
                        <ComboBoxItem Content="{DynamicResource Workspace_AllStates}" Tag="all" />
                        <ComboBoxItem Content="{DynamicResource Backlog_WantToPlay}" Tag="want" />
                        <ComboBoxItem Content="{DynamicResource Backlog_Playing}" Tag="playing" />
                        <ComboBoxItem Content="{DynamicResource Backlog_Completed}" Tag="completed" />
                        <ComboBoxItem Content="{DynamicResource Backlog_Later}" Tag="later" />
                        <ComboBoxItem Content="{DynamicResource Backlog_Hidden}" Tag="hidden" />
                    </ComboBox>
                </StackPanel>
                <Border x:Name="AdvancedFiltersPanel" Background="#151E2A" BorderBrush="#2B384B" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,12,0,0" Visibility="{Binding AdvancedFilters, Converter={StaticResource Visible}}" local:VisualMotion.EnterKey="{Binding AdvancedFilters}">
                    <ScrollViewer MaxHeight="204" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Filters_CollectionLabel}" Style="{StaticResource Kicker}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding Preferences.CollectionOptions}" SelectedItem="{Binding Preferences.SelectedCollection}" AutomationProperties.Name="{DynamicResource Filters_SelectCollection}" AutomationProperties.HelpText="{DynamicResource Filters_SelectCollection_HelpText}" />
                                <CheckBox Content="{DynamicResource Filters_ExcludeDeckUnsupported}" IsChecked="{Binding Preferences.ExcludeDeckUnsupported}" Style="{StaticResource Check}" Margin="0,12,0,4" />
                                <CheckBox Content="{DynamicResource Filters_RequireMacCompatible}" IsChecked="{Binding Preferences.RequireMacCompatible}" Style="{StaticResource Check}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Filters_ContentTypesLabel}" Style="{StaticResource Kicker}" Margin="0,0,0,8" />
                                <UniformGrid x:Name="ContentTypeFilters" Columns="3" Rows="2">
                                    <CheckBox Content="{DynamicResource Filters_IncludeGames}" IsChecked="{Binding Preferences.IncludeGames}" Style="{StaticResource Check}" Margin="0,8,12,8" />
                                    <CheckBox Content="{DynamicResource Filters_IncludeSoundtracks}" IsChecked="{Binding Preferences.IncludeSoundtracks}" Style="{StaticResource Check}" Margin="0,8,12,8" />
                                    <CheckBox Content="{DynamicResource Filters_IncludeSoftware}" IsChecked="{Binding Preferences.IncludeSoftware}" Style="{StaticResource Check}" Margin="0,8,12,8" />
                                    <CheckBox Content="{DynamicResource Filters_IncludeTools}" IsChecked="{Binding Preferences.IncludeTools}" Style="{StaticResource Check}" Margin="0,8,12,8" />
                                    <CheckBox Content="{DynamicResource Filters_IncludeVideos}" IsChecked="{Binding Preferences.IncludeVideos}" Style="{StaticResource Check}" Margin="0,8,12,8" />
                                    <CheckBox Content="{DynamicResource Filters_IncludeOther}" IsChecked="{Binding Preferences.IncludeOther}" Style="{StaticResource Check}" Margin="0,8,12,8" />
                                </UniformGrid>
                                <Button Content="{DynamicResource Workspace_ClearFilters}" Command="{Binding ResetFiltersCommand}" Style="{StaticResource Button}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <Grid Grid.Row="2" x:Name="PageHost" local:VisualMotion.EnterKey="{Binding ActivePage}">
                <ScrollViewer Visibility="{Binding IsDiscoverPage, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}" Margin="0,0,0,24" x:Name="SelectedGameCard" local:VisualMotion.EnterKey="{Binding SelectedGame.Id}" local:VisualMotion.ClipRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid MinHeight="304" Background="#202B3D">
                                    <TextBlock Text="STEAM" FontSize="28" FontWeight="Bold" Foreground="#637B9E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <local:CachedArtwork SourcePath="{Binding SelectedGame.CoverImagePath}" AllowNetwork="{Binding NetworkEnabled}" Stretch="UniformToFill" AutomationProperties.Name="{Binding SelectedGame.Title}" />
                                    <Border Background="#E5122239" CornerRadius="6" Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18">
                                        <TextBlock Text="{Binding SelectedGame.InstallationStatus}" FontSize="12" Foreground="#D5E5FC" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="28">
                                    <TextBlock Text="{DynamicResource Workspace_Ready}" Style="{StaticResource Kicker}" Foreground="#80ABE8" />
                                    <TextBlock Text="{Binding SelectedGame.Title}" AutomationProperties.Name="{Binding SelectedGame.Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,12" />
                                    <TextBlock Text="{Binding SelectionReason}" Style="{StaticResource Text}" />
                                    <Grid Margin="0,24,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Button Content="{DynamicResource GameDetails_PlayButton}" Command="{Binding LaunchCommand}" Height="44" Background="#347CE2" BorderBrush="#508FE8" ToolTip="{Binding SelectedGame.LaunchErrorMessage}" AutomationProperties.Name="{DynamicResource GameDetails_PlayButton_Automation}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.CanLaunch}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource GameDetails_InstallButton}" Command="{Binding InstallCommand}" Height="44" Background="#347CE2" BorderBrush="#508FE8" ToolTip="{Binding SelectedGame.InstallErrorMessage}" AutomationProperties.Name="{DynamicResource GameDetails_InstallButton_Automation}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.CanLaunch}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <Button x:Name="BacklogButton" Grid.Column="2" Height="44" Style="{StaticResource Button}" Padding="10,8" Click="OnBacklogMenuClick" AutomationProperties.Name="{DynamicResource Workspace_Backlog}" AutomationProperties.HelpText="{Binding SelectedBacklogLabel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedBacklogLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" />
                                            </Grid>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom">
                                                    <MenuItem Header="{DynamicResource Backlog_WantToPlay}" Command="{Binding SetBacklogStatusCommand}" CommandParameter="WantToPlay" />
                                                    <MenuItem Header="{DynamicResource Backlog_Playing}" Command="{Binding SetBacklogStatusCommand}" CommandParameter="Playing" />
                                                    <MenuItem Header="{DynamicResource Backlog_Completed}" Command="{Binding SetBacklogStatusCommand}" CommandParameter="Completed" />
                                                    <MenuItem Header="{DynamicResource Backlog_Later}" Command="{Binding SetBacklogStatusCommand}" CommandParameter="Later" />
                                                    <MenuItem Header="{DynamicResource Backlog_Hidden}" Command="{Binding SetBacklogStatusCommand}" CommandParameter="Hidden" />
                                                    <MenuItem Header="{DynamicResource Backlog_None}" Command="{Binding SetBacklogStatusCommand}" CommandParameter="None" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Panel}" Visibility="{Binding HasNoMatches, Converter={StaticResource Visible}}" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Text}" Margin="0,12,0,20" />
                                <Button Content="{DynamicResource Workspace_ClearFilters}" Command="{Binding ResetFiltersCommand}" Style="{StaticResource Button}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Workspace_Suggestions}" FontSize="23" FontWeight="SemiBold" Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <Button x:Name="DrawButton" Content="{DynamicResource Workspace_Pick}" Command="{Binding DrawCommand}" Style="{StaticResource Button}" Grid.Column="1" Background="#347CE2" Padding="20,0" AutomationProperties.Name="{DynamicResource Filters_DrawButton_Automation}" AutomationProperties.HelpText="{DynamicResource Filters_DrawButton_HelpText}" Height="44" MinWidth="184" BorderBrush="#508FE8" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Suggestions}" Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}" Margin="0,0,-10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Button}" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" Margin="0,0,10,8" local:VisualMotion.ClipRadius="10" Background="#182231" BorderBrush="#2B3A50">
                                        <StackPanel>
                                            <local:CachedArtwork SourcePath="{Binding CoverImagePath}" AllowNetwork="{Binding DataContext.NetworkEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill" Height="122" />
                                            <StackPanel Margin="14">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Text}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Grid Visibility="{Binding IsLibraryPage, Converter={StaticResource Visible}}">
                    <ListBox ItemsSource="{Binding VisibleGames}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{DynamicResource Workspace_library}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Button}" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" Margin="0,0,10,8" local:VisualMotion.ClipRadius="10" Background="#182231" BorderBrush="#2B3A50">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="144" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:CachedArtwork SourcePath="{Binding CoverImagePath}" AllowNetwork="{Binding DataContext.NetworkEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill" Height="72" />
                                        <StackPanel Grid.Column="1" Margin="20,10">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text}" FontSize="12" Margin="0,7,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BacklogLabel}" Grid.Column="2" Style="{StaticResource Text}" Margin="16" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Visibility="{Binding HasNoMatches, Converter={StaticResource Visible}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="26" />
                        <Button Content="{DynamicResource Workspace_ClearFilters}" Command="{Binding ResetFiltersCommand}" Style="{StaticResource Button}" Margin="0,20,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Visibility="{Binding IsHistoryPage, Converter={StaticResource Visible}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="{DynamicResource Workspace_ClearHistory}" Command="{Binding ClearHistoryCommand}" Style="{StaticResource Button}" HorizontalAlignment="Right" Margin="0,0,0,18" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Button}" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" Margin="0,0,10,8" local:VisualMotion.ClipRadius="10" Background="#182231" BorderBrush="#2B3A50">
                                    <Grid Margin="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="16" />
                                        <TextBlock Text="{Binding Time}" Grid.Column="1" Style="{StaticResource Text}" Margin="20,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Workspace_NoHistory}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHistory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Workspace_Connection}" Style="{StaticResource Kicker}" />
                                <TextBlock Text="{DynamicResource Workspace_FamilyTitle}" FontSize="25" FontWeight="SemiBold" Margin="0,10" />
                                <TextBlock Text="{DynamicResource Workspace_FamilyHelp}" Style="{StaticResource Text}" MaxWidth="720" HorizontalAlignment="Left" />
                                <WrapPanel Margin="0,20,0,0">
                                    <Button Content="{DynamicResource Workspace_Connect}" Command="{Binding ConnectSteamCommand}" Style="{StaticResource Button}" Background="#2867D6" Margin="0,0,10,8" />
                                    <Button Content="{DynamicResource Workspace_Disconnect}" Command="{Binding DisconnectSteamCommand}" Style="{StaticResource Button}" Margin="0,0,10,8" />
                                    <Button Content="{DynamicResource Workspace_Cancel}" Command="{Binding CancelSyncCommand}" Style="{StaticResource Button}" Visibility="{Binding IsSyncBusy, Converter={StaticResource Visible}}" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding HasQrChallenge, Converter={StaticResource Visible}}" Margin="0,16,0,0">
                                    <Image x:Name="LoginQrImage" Width="220" Height="220" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Workspace_QrHelp}" />
                                    <TextBlock Text="{DynamicResource Workspace_QrHelp}" Style="{StaticResource Text}" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SyncSummary}" Style="{StaticResource Text}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding SyncError}" Foreground="#FFBDAC" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Workspace_Privacy}" FontSize="23" FontWeight="SemiBold" />
                                <CheckBox Content="{DynamicResource Workspace_Network}" IsChecked="{Binding NetworkEnabled}" Style="{StaticResource Check}" />
                                <TextBlock Text="{DynamicResource Workspace_NetworkHelp}" Style="{StaticResource Text}" />
                                <CheckBox Content="{DynamicResource Workspace_AvoidRepeats}" IsChecked="{Binding AvoidRepeats}" Style="{StaticResource Check}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Workspace_Diagnostics}" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource Text}" Margin="0,15,0,0" />
                                <WrapPanel Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="{Binding TotalGameCount}" FontSize="30" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Workspace_Total}" Style="{StaticResource Text}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="{Binding InstalledGameCount}" FontSize="30" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Workspace_Installed}" Style="{StaticResource Text}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="{Binding MissingNameCount}" FontSize="30" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Workspace_MissingNames}" Style="{StaticResource Text}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <TextBlock Text="{DynamicResource Workspace_Language}" Style="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Português" Command="{Binding ChangeLanguageCommand}" CommandParameter="pt-BR" Style="{StaticResource Button}" Margin="0,0,10,0" />
                            <Button Content="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US" Style="{StaticResource Button}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding LastRefreshError}" Foreground="#FFBDAC" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="{DynamicResource Workspace_Undo}" Command="{Binding UndoBacklogCommand}" Style="{StaticResource Button}" Grid.Column="1" Padding="12,6" Visibility="{Binding CanUndoBacklog, Converter={StaticResource Visible}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
